    "Paylaştığın videonun köşesinde kendi rumuzun (ve istersen logon/profil fotoğrafın) görünsün. Boş bırakırsan Duello markası kullanılır.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your handle (and, if you add one, your logo/photo) will show in the corner of the video you share. Leave it blank to use the Duello brand instead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaştığın videonun köşesinde kendi rumuzun (ve istersen logon/profil fotoğrafın) görünsün. Boş bırakırsan Duello markası kullanılır."
          }
        }
      }
    },
    "Paylaştığın videonun köşesinde kendi rumuzun (ve istersen logon/profil fotoğrafın) görünsün. Boş bırakırsan ReactDuel markası kullanılır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your handle (and, if you add one, your logo/photo) will show in the corner of the video you share. Leave it blank to use the ReactDuel brand instead."
