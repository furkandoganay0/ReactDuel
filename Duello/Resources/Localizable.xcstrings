    "Kaydetmezsen çektiğin görüntü silinir — skorun yine de geçmişine eklenmiş olur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't save, the footage is deleted — your score is still added to your history."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmezsen çektiğin görüntü silinir — skorun yine de geçmişine eklenmiş olur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no guardas, el video grabado se eliminará; tu puntuación de todos modos se añadirá a tu historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous n'enregistrez pas, la vidéo capturée sera supprimée — votre score sera tout de même ajouté à votre historique."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você não salvar, a gravação será excluída — sua pontuação ainda será adicionada ao seu histórico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不保存，你拍摄的视频将被删除——但你的分数仍会记录到历史中。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप सहेजते नहीं हैं, तो आपकी रिकॉर्ड की गई फुटेज हट जाएगी — फिर भी आपका स्कोर इतिहास में जुड़ जाएगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم تحفظ، سيتم حذف اللقطات التي سجلتها — ستظل نتيجتك مضافة إلى سجلك."
          }
        }
      }
    },
    "Kaydı Bırak": {
      "extractionState": "stale",
      "localizations": {
