    "\"Sistem\" seçiliyse cihazının dili kullanılır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If \"System\" is selected, your device's language is used."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Sistem\" seçiliyse cihazının dili kullanılır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se selecciona \"Sistema\", se usa el idioma de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si \"Système\" est sélectionné, la langue de votre appareil est utilisée."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se \"Sistema\" for selecionado, o idioma do seu dispositivo será usado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果选择“系统”，将使用您设备的语言。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि “सिस्टम” चुना गया है, तो आपके डिवाइस की भाषा का उपयोग किया जाएगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تم اختيار “النظام”، سيتم استخدام لغة جهازك."
          }
        }
      }
    },
