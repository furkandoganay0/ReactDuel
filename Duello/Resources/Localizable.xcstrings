    "Tepkini kaydet, otomatik kurgulanmış bir video ile paylaş. Hiçbir video ya da veri, sen paylaşmadan cihazından çıkmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your reaction, share an auto-edited video. No video or data leaves your device unless you share it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepkini kaydet, otomatik kurgulanmış bir video ile paylaş. Hiçbir video ya da veri, sen paylaşmadan cihazından çıkmaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba tu reacción, compártela como un video editado automáticamente. Ningún video o dato sale de tu dispositivo a menos que lo compartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre réaction, partagez-la sous forme de vidéo automatiquement montée. Aucune vidéo ni donnée ne quitte votre appareil sauf si vous la partagez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave sua reação, compartilhe como um vídeo editado automaticamente. Nenhum vídeo ou dado sai do seu dispositivo a menos que você o compartilhe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制你的反应，以自动剪辑好的视频分享出去。除非你主动分享，否则任何视频或数据都不会离开你的设备。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी प्रतिक्रिया रिकॉर्ड करें, इसे स्वतः संपादित वीडियो के रूप में शेयर करें। जब तक आप शेयर नहीं करते, कोई भी वीडियो या डेटा आपके डिवाइस से बाहर नहीं जाता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل ردة فعلك، وشاركها كفيديو مُحرَّر تلقائيًا. لا يغادر أي فيديو أو بيانات جهازك ما لم تقم بمشاركتها."
          }
        }
      }
    },
