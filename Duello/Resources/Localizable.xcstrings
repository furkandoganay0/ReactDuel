    "Şu ana kadar kaydettiğin video kaybolacak.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video you've recorded so far will be lost."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu ana kadar kaydettiğin video kaybolacak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El video que has grabado hasta ahora se perderá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo enregistrée jusqu'à présent sera perdue."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O vídeo que você gravou até agora será perdido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前已录制的视频将会丢失。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब तक रिकॉर्ड किया गया वीडियो खो जाएगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم فقدان الفيديو الذي سجلته حتى الآن."
          }
        }
      }
    },
    "Tahmin Et": {
      "extractionState": "stale",
      "localizations": {
        "en": {
