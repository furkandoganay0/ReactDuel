    "Kaydı bırakmak istediğine emin misin?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to discard this recording?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı bırakmak istediğine emin misin?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres descartar la grabación?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment abandonner l'enregistrement ?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja descartar a gravação?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要放弃这段录制吗？"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई रिकॉर्डिंग छोड़ना चाहते हैं?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد أنك تريد التخلص من التسجيل؟"
          }
        }
      }
    },
