    "Tahmin Et modunda cevap sonrası kısa bir ses efekti çalar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a short sound effect after each answer in Guess It mode."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmin Et modunda cevap sonrası kısa bir ses efekti çalar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo Adivina, se reproduce un breve efecto de sonido después de cada respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode Devine, un court effet sonore est joué après chaque réponse."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo Adivinhe, toca um breve efeito sonoro após cada resposta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“猜一猜”模式中，每次回答后会播放一个简短的音效。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“अंदाज़ा लगाओ” मोड में, हर उत्तर के बाद एक छोटा साउंड इफ़ेक्ट बजता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في وضع “خمّن”، يتم تشغيل مؤثر صوتي قصير بعد كل إجابة."
          }
        }
      }
    },
