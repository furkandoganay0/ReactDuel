    "Açıksa, bugün henüz oynamadıysan akşam kısa bir hatırlatma bildirimi alırsın.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, you'll get a short reminder notification in the evening if you haven't played yet today."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıksa, bugün henüz oynamadıysan akşam kısa bir hatırlatma bildirimi alırsın."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, recibirás una breve notificación por la noche si aún no has jugado hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, vous recevrez une courte notification de rappel le soir si vous n'avez pas encore joué aujourd'hui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ativado, você receberá uma breve notificação à noite caso ainda não tenha jogado hoje."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，如果你今天还没玩过，晚上会收到一条简短的提醒通知。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर, अगर आपने आज अभी तक नहीं खेला है तो आपको शाम को एक छोटी रिमाइंडर सूचना मिलेगी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، ستتلقى إشعار تذكير قصير في المساء إذا لم تلعب اليوم بعد."
          }
        }
      }
    },
