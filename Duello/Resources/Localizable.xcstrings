    "Oynadığın oyunlar ve kaydettiğin videolar burada birikecek.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The games you play and the videos you save will show up here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynadığın oyunlar ve kaydettiğin videolar burada birikecek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos que juegues y los videos que guardes se acumularán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeux auxquels vous jouez et les vidéos que vous enregistrez s'accumuleront ici."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jogos que você joga e os vídeos que salva se acumularão aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你玩过的游戏和保存的视频会显示在这里。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खेले गए गेम और सहेजे गए वीडियो यहाँ जमा होंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتجمع هنا الألعاب التي لعبتها ومقاطع الفيديو التي حفظتها."
          }
        }
      }
    },
